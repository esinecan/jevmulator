# Copy to .env and fill in. .env is ignored by git; this file holds no secret.

# ---------------------------------------------------------------------------
# Daemon credential. Callers of this daemon send it as: Authorization: Bearer <value>
# Leave it unset and the daemon generates a random key at startup and stores it in
# .jevmulator/runtime.json; read it with:  .\jevmulator.ps1 status -ShowKey
# ---------------------------------------------------------------------------
JEVMULATOR_API_KEY=replace-with-a-local-token

# ---------------------------------------------------------------------------
# Upstream provider. Any OpenAI-compatible Chat Completions endpoint works.
# The default targets GLM Flash on z.ai.
# ---------------------------------------------------------------------------
JEVMULATOR_PROVIDER=openai
JEVMULATOR_UPSTREAM_BASE_URL=https://api.z.ai/api/coding/paas/v4
JEVMULATOR_UPSTREAM_MODEL=glm-5.3-flash

# The upstream key is referenced BY NAME, so this file never holds the secret itself.
# Export ZAI_API_KEY in your shell, or point this at another variable.
JEVMULATOR_UPSTREAM_API_KEY_ENV=ZAI_API_KEY

# Only if you cannot use an environment variable. Prefer the name reference above.
# JEVMULATOR_UPSTREAM_API_KEY=

# ---------------------------------------------------------------------------
# Upstream call shape
# ---------------------------------------------------------------------------
# json_schema (strict structured output), json_object, or none (prompted JSON).
JEVMULATOR_RESPONSE_FORMAT=json_schema
# disabled, enabled, or omit. z.ai reads {"thinking": {"type": ...}}.
JEVMULATOR_UPSTREAM_THINKING=disabled
JEVMULATOR_UPSTREAM_TEMPERATURE=0
JEVMULATOR_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------
# Network binding
# ---------------------------------------------------------------------------
JEVMULATOR_HOST=127.0.0.1
JEVMULATOR_PORT=8769

# ---------------------------------------------------------------------------
# Timeouts, retries and concurrency
# ---------------------------------------------------------------------------
JEVMULATOR_UPSTREAM_TIMEOUT_SECONDS=60
JEVMULATOR_REQUEST_TIMEOUT_SECONDS=120
JEVMULATOR_UPSTREAM_RETRIES=2
JEVMULATOR_REPAIR_RETRIES=1
JEVMULATOR_MAX_UPSTREAM_CONCURRENCY=4
JEVMULATOR_MAX_INFLIGHT_REQUESTS=16

# ---------------------------------------------------------------------------
# Compatibility policy
# ---------------------------------------------------------------------------
JEVMULATOR_NORMALIZE_PROBABILITIES=1
JEVMULATOR_PROBABILITY_TOLERANCE=0.000001
# reject or accept
JEVMULATOR_UNKNOWN_MODEL=reject
# upstream or strict
JEVMULATOR_USAGE_POLICY=upstream

# ---------------------------------------------------------------------------
# Size guards. 0 disables the character guards. They count characters, NOT
# TypeSafe tokens; TypeSafe's tokenizer is unverified.
# ---------------------------------------------------------------------------
JEVMULATOR_MAX_BODY_BYTES=8388608
JEVMULATOR_MAX_STATE_CHARS=0
JEVMULATOR_MAX_REQUEST_CHARS=0

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# 1 exposes GET /_jevmulator/debug/upstream-calls with the exact upstream payloads.
JEVMULATOR_DEBUG_RECORD=0
JEVMULATOR_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# sys1: the harnessed mode on /sys1. pi reads its key from ZAI_API_KEY.
# ---------------------------------------------------------------------------
JEVMULATOR_SYS1_HARNESS=pi
JEVMULATOR_SYS1_DEFAULT_PROFILE=read-only
# 1 enables profiles that can write files or run commands (prototype-first). pi has no
# sandbox on Windows, and the state comes from the caller. Leave it 0 unless you trust
# every request.
JEVMULATOR_SYS1_ALLOW_SHELL=0
# Run directories. Keep this outside every repository. Default: %LOCALAPPDATA%\jevmulator\sys1
# JEVMULATOR_SYS1_HOME=
JEVMULATOR_SYS1_RUN_TIMEOUT_SECONDS=600
JEVMULATOR_SYS1_STALL_SECONDS=180
JEVMULATOR_SYS1_MAX_CONCURRENT_RUNS=1
JEVMULATOR_SYS1_MAX_SUBMISSIONS=3
JEVMULATOR_SYS1_MAX_SUM_ERROR=0.01
JEVMULATOR_SYS1_RESULT_TTL_SECONDS=600
JEVMULATOR_SYS1_FAILURE_TTL_SECONDS=120
# Found automatically. Set them when node or pi live somewhere else.
# JEVMULATOR_SYS1_NODE=C:\Program Files\nodejs\node.exe
# JEVMULATOR_SYS1_PI_CLI=
